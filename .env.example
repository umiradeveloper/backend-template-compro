# ========== APP ==========
NODE_ENV=development
PORT=4000
# URL publik backend (dipakai untuk membentuk URL file upload)
APP_URL=http://localhost:4000
# URL publik folder upload (gambar/video/PDF). Isi bila file disajikan Nginx/CDN terpisah
# dari API, mis. ASSET_URL=https://files.umiraglobal.com/uploads — kosong = <APP_URL>/uploads
ASSET_URL=
# Origin yang boleh mengakses API (admin panel & website), pisahkan dengan koma
CORS_ORIGINS=http://localhost:5173,http://localhost:3005

# ========== DATABASE (MySQL) ==========
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=umira_cms
# true = tabel dibuat/diupdate otomatis (hanya untuk development).
# Untuk production set false lalu jalankan: npm run migration:run
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ========== AUTH ==========
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=1d

# ========== UPLOAD ==========
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# ========== SEEDER ==========
# Akun super admin awal
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@umiraglobal.com
SEED_ADMIN_PASSWORD=Admin@12345
# Folder salinan website lama untuk impor konten (markdown, message JSON, public/images)
SEED_CONTENT_DIR=./websitelama
# Folder gambar/video/PDF bawaan website (disalin ke UPLOAD_DIR/site & didaftarkan ke Media Library saat seed)
SEED_ASSETS_DIR=./seeds/assets
