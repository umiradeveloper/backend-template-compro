# ========== APP ==========
NODE_ENV=development
PORT=4000
# URL publik backend (dipakai untuk membentuk URL file upload)
APP_URL=http://localhost:4000
# Origin yang boleh mengakses API (admin panel & website), pisahkan dengan koma
CORS_ORIGINS=http://localhost:5173,http://localhost:3005

# ========== DATABASE (MySQL) ==========
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=umira_cms
# true = tabel dibuat/diupdate otomatis (hanya untuk development).
# Untuk production set false lalu jalankan: npm run migration:run
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ========== AUTH ==========
JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=1d

# ========== UPLOAD ==========
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# ========== SEEDER ==========
# Akun super admin awal
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@umiraglobal.com
SEED_ADMIN_PASSWORD=Admin@12345
# Folder salinan website lama untuk impor konten (markdown, message JSON, public/images)
SEED_CONTENT_DIR=./websitelama

# ========== PENYIMPANAN FILE ==========
# local = simpan di folder UPLOAD_DIR | minio = simpan di MinIO (S3 compatible)
STORAGE_DRIVER=local
# Cache browser untuk file media (setelah "Ganti file", perubahan tampil maks. selama ini)
STORAGE_CACHE_CONTROL=public, max-age=300

# ========== MINIO (dipakai bila STORAGE_DRIVER=minio) ==========
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=umira-cms
MINIO_REGION=us-east-1
# URL yang dibuka browser untuk menampilkan file (domain publik MinIO / CDN).
# Contoh: https://files.umiraglobal.com  → gambar: https://files.umiraglobal.com/umira-cms/2026/11/foto.jpg
MINIO_PUBLIC_URL=http://localhost:9000
# Buat bucket & set akses baca publik otomatis saat backend start
MINIO_AUTO_CREATE_BUCKET=true
